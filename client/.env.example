# Copy this file to .env and fill in your actual ExpressTURN credentials.
# .env is gitignored — never commit real credentials.
# Vite only exposes env vars prefixed with VITE_ to client code.
VITE_TURN_HOST=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# WebSocket URL of the signaling server. Leave unset for local dev (falls
# back to ws://localhost:3000). In production this must be wss:// (TLS) since
# the client is served over https:// and browsers block insecure ws:// from
# an https:// page.
VITE_WS_URL=
